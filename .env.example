# PracticeSignal — .env.example (M0)
#
# Configuration template. We deliberately need NO credentials, NO API keys,
# and NO paid services (zero-cost policy; ARCHITECTURE §7, DECISION_LOG D21).
# Copy to .env for local overrides; .env is git-ignored.
#
# Any newly introduced variable MUST be added here first with a comment
# explaining purpose, default and format, or the change is rejected in review.

# --- AI runtime (local only; no cloud calls) ---
# HTTP base URL of the local Ollama server.
OLLAMA_URL=http://localhost:11434

# Pinned extraction model tag (DECISION_LOG D2/D3). Do not change without a
# measured benchmark reason (D5).
OLLAMA_MODEL=llama3.2:3b

# --- Application binding (localhost only; ARCHITECTURE §8) ---
APP_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Database (local SQLite file; excluded from Git) ---
DATABASE_PATH=backend/data/practicesignal.db

# --- Fetch policy (conservative defaults; ARCHITECTURE §3.1/D13) ---
FETCH_DELAY_SECONDS=3
FETCH_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=2000000
MAX_PAGES_PER_RUN=10

# --- Localisation ---
DEFAULT_TIMEZONE=Australia/Brisbane
